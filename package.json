{
  "name": "swarm",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev": "pnpm --parallel --filter \"./workers/*\" --filter @swarm/dashboard dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "load:import": "node scripts/load/import-50k.mjs",
    "load:circles": "node scripts/load/circle-counts.mjs",
    "test:e2e": "pnpm --filter @swarm/e2e test:e2e",
    "test:wordpress": "pnpm --filter @swarm/e2e test:wordpress",
    "openapi": "pnpm --filter @swarm/api openapi",
    "openapi:v2": "pnpm --filter @swarm/api openapi:v2 && pnpm --filter @swarm/sdk generate",
    "migrations:lock": "node scripts/lock-migrations.mjs",
    "release:bundle": "node scripts/release-bundle.mjs",
    "release:sign": "node scripts/release-sign.mjs",
    "swarm": "pnpm --silent --filter @swarm/installer exec tsx src/cli.ts",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "sbom": "node scripts/sbom.mjs",
    "provision": "node scripts/provision.mjs",
    "check:provisioned": "node scripts/check-provisioned.mjs",
    "check:dry-run": "pnpm --filter \"./workers/*\" check:deploy",
    "check:setup": "node scripts/check-setup-start.mjs",
    "db:migrate:local": "pnpm --filter @swarm/api exec wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "db:migrate:staging": "pnpm --filter @swarm/api exec wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "pnpm --filter @swarm/api exec wrangler d1 migrations apply DB --remote --env production"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "ts-prune": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
