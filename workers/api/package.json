{
  "name": "@swarm/api",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "wrangler dev --port 8787 --inspector-port 9240 --persist-to ../../.wrangler/state",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "check:deploy": "wrangler deploy --dry-run --outdir dist",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:v2": "tsx scripts/openapi-v2.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:stripe-live": "vitest run --config vitest.stripe-live.config.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@swarm/db": "workspace:*",
    "@swarm/domain": "workspace:*",
    "@swarm/flags": "workspace:*",
    "@swarm/mail": "workspace:*",
    "@swarm/runtime": "workspace:*",
    "@swarm/site-themes": "workspace:*",
    "@swarm/tokens": "workspace:*",
    "@swarm/vault": "workspace:*",
    "hono": "catalog:",
    "tldts": "catalog:",
    "zod": "catalog:",
    "@swarm/engine": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@swarm/sdk": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
