"{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Branded links, the open pixel and unsubscribe pages. TRACK_KEYS and UNSUBSCRIBE_KEYS are
  // secrets shared with the send worker (.dev.vars locally).
  // Not the production name: a deploy that names no environment makes a separate, harmless
  // "-local" script, never a production one with these development settings.
  "name": "swarm-track-local",
  // No provider default hostname and no preview URLs: a worker answers only on the routes
  // the installer gives it (docs/deployment.md, "Public surface"). Stated here, in each
  // environment too, so nothing rests on a platform default.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "development" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swarm",
      "database_id": "local",
      "migrations_dir": "../../migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "swarm-track-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swarm-staging",
          "database_id": "unprovisioned",
          "migrations_dir": "../../migrations",
        },
      ],
    },
    "production": {
      "name": "swarm-track",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swarm-production",
          "database_id": "11111111-2222-3333-4444-555555555555",
          "migrations_dir": "../../migrations",
        },
      ],
      "routes": [
        {
          "pattern": "link.example.com/*",
          "zone_name": "example.com"
        }
      ],
    },
  },
}
"
`;

exports[`render with resend > vault: only the production block changes, comments stay, no placeholders 1`] = `
"{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The vault: the only Worker that holds FIELD_KEYS, and the Member Center, goods and signup link
  // keys for the workers that face the internet (docs/security.md "The vault"). It has no route,
  // no workers.dev name and no preview URLs: api, capture, site and jobs reach it only through a
  // service binding, each pinned to its own named entrypoint (ApiVault, CaptureVault, SiteVault,
  // JobsVault), so each can call only its own operations. Its fetch answers 404.
  // Cron every 5 minutes: re-seal stored values (to the row-bound v3 format once
  // VAULT_WRITE_FORMAT is v3, or onto the current key after a FIELD_KEYS rotation) and prune
  // vault_audit, vault_mints and vault_rate.
  // Secrets (FIELD_KEYS, SIGNUP_KEYS, MEMBER_SIGNING_KEYS, MEMBER_VERIFY_KEYS, GOODS_SIGNING_KEYS,
  // MEMBER_KEYS while v1 links are accepted; STRIPE_SECRET_KEY when payments are on,
  // DEBOUNCE_API_KEY when email checks are on) go in .dev.vars locally and the installer's secrets
  // file elsewhere. Deploys after realtime and before every caller: a service binding to a script
  // that does not exist fails the caller's upload.
  // Not the production name: a deploy that names no environment makes a separate, harmless
  // "-local" script, never a production one with these development settings.
  "name": "swarm-vault-local",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    // As every other worker locally: v2 from the start, and no v1 link is taken. The vault signs
    // the Member Center and goods links that capture and site check, so the modes must match
    // (staging and production render them from state, the same for every worker).
    "LINK_SIGNING_MODE": "v2",
    "LINK_LEGACY_CUTOFF": "0",
    // What callers that still hold FIELD_KEYS can read; v3 only once none do.
    "VAULT_WRITE_FORMAT": "legacy",
    "VAULT_LEGACY_OPEN": "on",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swarm",
      "database_id": "local",
      "migrations_dir": "../../migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "swarm-vault-staging",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "LINK_SIGNING_MODE": "v1",
        "VAULT_WRITE_FORMAT": "legacy",
        "VAULT_LEGACY_OPEN": "on",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swarm-staging",
          "database_id": "unprovisioned",
          "migrations_dir": "../../migrations",
        },
      ],
    },
    "production": {
      "name": "swarm-vault",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "LINK_SIGNING_MODE": "v1",
        "VAULT_WRITE_FORMAT": "legacy",
        "VAULT_LEGACY_OPEN": "on",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swarm-production",
          "database_id": "11111111-2222-3333-4444-555555555555",
          "migrations_dir": "../../migrations",
        },
      ],
    },
  },
}
"
`;

exports[`render with ses > api: only the production block changes, comments stay, no placeholders 1`] = `
"{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Not the production name: a deploy that names no environment makes a separate, harmless
  // "-local" script, never a production one with these development settings.
  "name": "swarm-api-local",
  // No provider default hostname and no preview URLs: a worker answers only on the routes
  // the installer gives it (docs/deployment.md, "Public surface"). Stated here, in each
  // environment too, so nothing rests on a platform default.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Local development. Secrets (AUTH_KEYS, TURNSTILE_SECRET_KEY, Google) go in .dev.vars;
  // see .dev.vars.example. Real resource ids for staging and production are written by
  // \`node scripts/provision.mjs <env>\`.
  "vars": {
    "ENVIRONMENT": "development",
    // Links are signed per family (docs/security.md "Keys"). Locally there are no old links to
    // keep: v2 from the start, and no v1 link is taken.
    "LINK_SIGNING_MODE": "v2",
    "LINK_LEGACY_CUTOFF": "0",
    "APP_ORIGIN": "http://localhost:5273",
    "MEDIA_ORIGIN": "http://localhost:8792",
    "CAPTURE_ORIGIN": "http://localhost:8791",
    "MAIL_ADAPTER": "dev",
    "MAIL_FROM": "signin@swarm.localhost",
    "AWS_REGION": "us-east-1",
    "DNS_RESOLVER": "dev",
    "LINK_HOSTNAMES": "dev",
    "TRACK_ORIGIN": "http://localhost:8790",
    "PLATFORM_MAIL_DOMAIN": "mail.swarm.localhost",
    "UNSUBSCRIBE_MAIL_DOMAIN": "unsubscribe.swarm.localhost",
    "DMARC_MAIL_DOMAIN": "dmarc.swarm.localhost",
    "PLATFORM_SITE_DOMAIN": "site.localhost",
    "SITE_SCHEME": "http",
    "WEB_HOSTNAMES": "dev",
    "SITE_FALLBACK_ORIGIN": "sites.site.localhost",
    // Cloudflare's public always-pass test site key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Membership levels: the Stripe fake locally. STRIPE_* secrets are only needed for "stripe".
    "PAYMENTS": "dev",
    // Copilot: the deterministic fake locally. "workers-ai" needs the AI binding (declared per
    // environment below); ANTHROPIC_API_KEY is only needed for "anthropic". AI_GATEWAY_ID and
    // AI_GATEWAY_ACCOUNT_ID are optional (docs/deployment.md).
    "COPILOT_ADAPTER": "dev",
    "COPILOT_MODEL": "claude-opus-5-5",
    "COPILOT_WORKERS_AI_MODEL": "@cf/moonshotai/kimi-k2.6",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swarm",
      "database_id": "local",
      "migrations_dir": "../../migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "local" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "SEND_MONITOR",
        "class_name": "SendMonitor",
        "script_name": "swarm-realtime-local",
      },
      {
        "name": "API_RATE_LIMITER",
        "class_name": "ApiRateLimiter",
        "script_name": "swarm-realtime-local",
      },
      { "name": "SEND_PACER", "class_name": "SendPacer", "script_name": "swarm-realtime-local" },
    ],
  },
  "queues": {
    "producers": [
      { "binding": "SEND_QUEUE", "queue": "swarm-send" },
      { "binding": "JOBS_QUEUE", "queue": "swarm-jobs" },
      { "binding": "WEBHOOKS_QUEUE", "queue": "swarm-webhooks" },
    ],
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "swarm-media" },
    { "binding": "IMPORTS", "bucket_name": "swarm-imports" },
    { "binding": "EXPORTS", "bucket_name": "swarm-exports" },
    { "binding": "DEV_MAILBOX", "bucket_name": "swarm-dev-mailbox" },
  ],
  // Rate-limit namespace ids are account-wide, so each environment has its own: 100x locally,
  // 101x in staging, 102x in production (pnpm check:provisioned rejects a shared id).
  "ratelimits": [
    {
      "name": "QUICKPASS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "TEST_SEND_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],

  // The vault (workers/vault), through its ApiVault entrypoint and no other: sealed values,
  // the links it signs and the provider credentials it holds. Every env block names it too.
  "services": [{ "binding": "VAULT", "service": "swarm-vault-local", "entrypoint": "ApiVault" }],
  "env": {
    "staging": {
      "name": "swarm-api-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
