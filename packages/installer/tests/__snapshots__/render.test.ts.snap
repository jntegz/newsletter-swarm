          {
            "queue": "swarm-production-webhooks",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "dead_letter_queue": "swarm-production-webhooks-dlq",
          },
          {
            "queue": "swarm-production-public",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 8,
            "dead_letter_queue": "swarm-production-public-dlq",
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          { "name": "SEND_PACER", "class_name": "SendPacer", "script_name": "swarm-realtime" },
        ],
      },
      "services": [
        {
          "binding": "VAULT",
          "service": "swarm-vault",
          "entrypoint": "JobsVault",
        },
      ],
    },
  },
}
"
`;

exports[`render with ses > realtime: only the production block changes, comments stay, no placeholders 1`] = `
"{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Durable Objects: the live send monitor, the sliding-window rate limiters, the /v2 token
  // buckets and the install's send pacer; editor rooms join later. Other workers bind to these classes with script_name
  // "swarm-realtime" (production), "swarm-realtime-staging", or "swarm-realtime-local" locally.
  // Not the production name: a deploy that names no environment makes a separate, harmless
  // "-local" script, never a production one with these development settings.
  "name": "swarm-realtime-local",
  // No provider default hostname and no preview URLs: a worker answers only on the routes
  // the installer gives it (docs/deployment.md, "Public surface"). Stated here, in each
  // environment too, so nothing rests on a platform default.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "development" },
  "durable_objects": {
    "bindings": [
      { "name": "SEND_MONITOR", "class_name": "SendMonitor" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "API_RATE_LIMITER", "class_name": "ApiRateLimiter" },
      { "name": "SEND_PACER", "class_name": "SendPacer" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SendMonitor"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["ApiRateLimiter"] },
    { "tag": "v4", "new_sqlite_classes": ["SendPacer"] },
  ],
  "env": {
    "staging": {
      "name": "swarm-realtime-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "staging" },
      "durable_objects": {
        "bindings": [
          { "name": "SEND_MONITOR", "class_name": "SendMonitor" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "API_RATE_LIMITER", "class_name": "ApiRateLimiter" },
          { "name": "SEND_PACER", "class_name": "SendPacer" },
        ],
      },
    },
    "production": {
      "name": "swarm-realtime",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "production" },
      "durable_objects": {
        "bindings": [
          { "name": "SEND_MONITOR", "class_name": "SendMonitor" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "API_RATE_LIMITER", "class_name": "ApiRateLimiter" },
          { "name": "SEND_PACER", "class_name": "SendPacer" },
        ],
      },
    },
  },
}
"
`;

