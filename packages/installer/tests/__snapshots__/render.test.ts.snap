exports[`render with resend > capture: only the production block changes, comments stay, no placeholders 1`] = `
"{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Capture Forms, confirm opt-in and the Member Center, served on the forms origin.
  // Secrets (FIELD_KEYS, the link keyrings, TURNSTILE_SECRET_KEY, STRIPE_SECRET_KEY where PAYMENTS is
  // "stripe", and the AWS credentials where SES is used) go in .dev.vars locally and
  // \`wrangler secret put\` elsewhere. CAPTURE_ORIGIN must match the api, send and jobs workers: the
  // api hashes the embed script for SRI with it.
  // Not the production name: a deploy that names no environment makes a separate, harmless
  // "-local" script, never a production one with these development settings.
  "name": "swarm-capture-local",
  // No provider default hostname and no preview URLs: a worker answers only on the routes
  // the installer gives it (docs/deployment.md, "Public surface"). Stated here, in each
  // environment too, so nothing rests on a platform default.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Gentle Reminders.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    // Links are signed per family (docs/security.md "Keys"). Locally there are no old links to
    // keep: v2 from the start, and no v1 link is taken.
    "LINK_SIGNING_MODE": "v2",
    "LINK_LEGACY_CUTOFF": "0",
    "CAPTURE_ORIGIN": "http://localhost:8791",
    // Channel websites: Champions share links, Signup Journey upsells and survey links.
    "PLATFORM_SITE_DOMAIN": "site.localhost",
    "SITE_SCHEME": "http",
    "PLATFORM_MAIL_DOMAIN": "mail.swarm.localhost",
    "MAIL_ADAPTER": "dev",
    "AWS_REGION": "us-east-1",
    "DNS_RESOLVER": "dev",
    "LINK_HOSTNAMES": "off",
    // Member Center billing runs on the Stripe fake locally.
    "PAYMENTS": "dev",
    // Cloudflare's always-pass test site key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swarm",
      "database_id": "local",
      "migrations_dir": "../../migrations",
    },
  ],
  // EXPORTS: Privacy Center data exports, streamed by the download page (read only here).
  "r2_buckets": [
    { "binding": "DEV_MAILBOX", "bucket_name": "swarm-dev-mailbox" },
    { "binding": "EXPORTS", "bucket_name": "swarm-exports" },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter",
        "script_name": "swarm-realtime-local",
      },
      { "name": "SEND_PACER", "class_name": "SendPacer", "script_name": "swarm-realtime-local" },
    ],
  },
  // The public queue only (never the jobs queue): Circles re-evaluate when a sign-up, confirmation
  // or Member Center action changes a Member, and a confirmed signup is checked.
  "queues": { "producers": [{ "binding": "PUBLIC_QUEUE", "queue": "swarm-public" }] },
  // The vault (workers/vault), through its CaptureVault entrypoint and no other: sealed values,
  // the links it signs and the provider credentials it holds. Every env block names it too.
  "services": [
    { "binding": "VAULT", "service": "swarm-vault-local", "entrypoint": "CaptureVault" },
  ],
  "env": {
    "staging": {
      "name": "swarm-capture-staging",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        // The installer sets both: v1 until the cutover, then v2 and its time.
        "LINK_SIGNING_MODE": "v1",
        "PLATFORM_SITE_DOMAIN": "staging.site.swarm.example",
        "SITE_SCHEME": "https",
        "CAPTURE_ORIGIN": "https://forms.staging.swarm.example",
        "PLATFORM_MAIL_DOMAIN": "mail.staging.swarm.example",
        "MAIL_ADAPTER": "ses",
        "AWS_REGION": "eu-west-1",
        "SES_CONFIGURATION_SET": "swarm-staging-transactional",
        "DNS_RESOLVER": "doh",
        "LINK_HOSTNAMES": "off",
        "PAYMENTS": "stripe",
        "TURNSTILE_SITE_KEY": "unprovisioned",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swarm-staging",
          "database_id": "unprovisioned",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "swarm-staging-exports" }],
      "queues": { "producers": [{ "binding": "PUBLIC_QUEUE", "queue": "swarm-staging-public" }] },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiter",
            "script_name": "swarm-realtime-staging",
          },
          {
            "name": "SEND_PACER",
            "class_name": "SendPacer",
            "script_name": "swarm-realtime-staging",
          },
        ],
      },
      "services": [
        {
          "binding": "VAULT",
          "service": "swarm-vault-staging",
          "entrypoint": "CaptureVault",
        },
      ],
    },
    "production": {
      "name": "swarm-capture",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        // The installer sets both: v1 until the cutover, then v2 and its time.
        "LINK_SIGNING_MODE": "v1",
        "PLATFORM_SITE_DOMAIN": "example.com",
        "SITE_SCHEME": "https",
        "CAPTURE_ORIGIN": "https://forms.example.com",
        "PLATFORM_MAIL_DOMAIN": "mail.example.com",
        "MAIL_ADAPTER": "resend",
        "AWS_REGION": "us-east-1",
        "DNS_RESOLVER": "doh",
        "LINK_HOSTNAMES": "off",
        "PAYMENTS": "off",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAATestSiteKey",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swarm-production",
          "database_id": "11111111-2222-3333-4444-555555555555",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "swarm-production-exports" }],
      "queues": {
        "producers": [{ "binding": "PUBLIC_QUEUE", "queue": "swarm-production-public" }],
      },
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter", "script_name": "swarm-realtime" },
          { "name": "SEND_PACER", "class_name": "SendPacer", "script_name": "swarm-realtime" },
        ],
      },
      "services": [
        {
          "binding": "VAULT",
          "service": "swarm-vault",
          "entrypoint": "CaptureVault",
        },
      ],
      "routes": [
        {
          "pattern": "forms.example.com/*",
          "zone_name": "example.com"
        }
      ],
    },
  },
}
"
`;

exports[`render with resend > events: only the production block changes, comments stay, no placeholders 1`] = `
"{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // SES events over SNS, and Email Routing for unsub+<code>@ addresses (UNSUBSCRIBE_MAIL_DOMAIN)
  // and DMARC aggregate reports to dmarc+<sendingDomainId>@ (DMARC_MAIL_DOMAIN), kept in R2
  // REPORTS. SNS_TOPIC_ARNS must list the real topics (docs/deployment.md); UNSUBSCRIBE_KEYS is a
  // secret shared with the send and track workers.
  // Not the production name: a deploy that names no environment makes a separate, harmless
  // "-local" script, never a production one with these development settings.
  "name": "swarm-events-local",
  // No provider default hostname and no preview URLs: a worker answers only on the routes
  // the installer gives it (docs/deployment.md, "Public surface"). Stated here, in each
  // environment too, so nothing rests on a platform default.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "development",
    // Links are signed per family (docs/security.md "Keys"). Locally there are no old links to
    // keep: v2 from the start, and no v1 link is taken.
    "LINK_SIGNING_MODE": "v2",
    "LINK_LEGACY_CUTOFF": "0",
    "SNS_TOPIC_ARNS": "arn:aws:sns:us-east-1:000000000000:swarm-dev-ses-events",
    "DMARC_MAIL_DOMAIN": "dmarc.swarm.localhost",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swarm",
      "database_id": "local",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "swarm-reports" }],
  // The public queue only (never the jobs queue): Circles re-evaluate when a bounce or complaint
  // changes a Member.
  "queues": { "producers": [{ "binding": "PUBLIC_QUEUE", "queue": "swarm-public" }] },
  "env": {
    "staging": {
      "name": "swarm-events-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
        // The installer sets both: v1 until the cutover, then v2 and its time.
        "LINK_SIGNING_MODE": "v1",
        "SNS_TOPIC_ARNS": "arn:aws:sns:eu-west-1:000000000000:swarm-staging-ses-events",
        "DMARC_MAIL_DOMAIN": "dmarc.staging.swarm.example",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swarm-staging",
          "database_id": "unprovisioned",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "swarm-staging-reports" }],
      "queues": { "producers": [{ "binding": "PUBLIC_QUEUE", "queue": "swarm-staging-public" }] },
    },
    "production": {
      "name": "swarm-events",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        // The installer sets both: v1 until the cutover, then v2 and its time.
        "LINK_SIGNING_MODE": "v1",
        "DMARC_MAIL_DOMAIN": "dmarc.example.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swarm-production",
          "database_id": "11111111-2222-3333-4444-555555555555",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "swarm-production-reports" }],
      "queues": {
        "producers": [{ "binding": "PUBLIC_QUEUE", "queue": "swarm-production-public" }],
      },
      "routes": [
        {
          "pattern": "events.example.com/*",
          "zone_name": "example.com"
        }
      ],
    },
  },
}
"
`;

exports[`render with resend > jobs: only the production block changes, comments stay, no placeholders 1`] = `
"{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Background jobs: imports, exports, bulk actions, Circle evaluation, Flows, Privacy Center
  // requests and export destinations, Event Webhooks.
  // Crons: every minute (the Flows sweep: due delays and waits, member events; data requests; the
  // webhook fan-out and sweep); every 5 minutes (Member maintenance, due Circles, pending web
  // hostnames, the payments lifecycle, export destinations, expired data-export files and scheduled
  // website designs); daily at 03:30 UTC (site edge housekeeping, the Flows unengaged check,
  // webhook pruning). The minute cron also applies queued SES suppression-list changes and mails
  // Reputation Ramp pause notices (linking to APP_ORIGIN); the 5-minute cron pulls SES-side
  // suppressions back.
  // WEBHOOKS_QUEUE is produced and consumed here (one message per delivery attempt; the API also
  // produces for test events and redrives). The public queue (swarm-public) is only consumed
  // here: capture and events produce on it and on no other queue. SEND_QUEUE carries Flow emails
  // to the send worker; Flow notices to operators go out by mail (MAIL_ADAPTER). Secrets
  // (FIELD_KEYS, the link keyrings; CF_ZONE_ID and CF_API_TOKEN for web hostnames; STRIPE_SECRET_KEY
  // when PAYMENTS is "stripe"; AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY when MAIL_ADAPTER is
  // "ses") go in .dev.vars locally and \`wrangler secret put\` elsewhere.
  // Not the production name: a deploy that names no environment makes a separate, harmless
  // "-local" script, never a production one with these development settings.
  "name": "swarm-jobs-local",
  // No provider default hostname and no preview URLs: a worker answers only on the routes
  // the installer gives it (docs/deployment.md, "Public surface"). Stated here, in each
  // environment too, so nothing rests on a platform default.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *", "*/5 * * * *", "30 3 * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    // Links are signed per family (docs/security.md "Keys"). Locally there are no old links to
    // keep: v2 from the start, and no v1 link is taken.
    "LINK_SIGNING_MODE": "v2",
    "LINK_LEGACY_CUTOFF": "0",
    "APP_ORIGIN": "http://localhost:5273",
    "CAPTURE_ORIGIN": "http://localhost:8791",
    "WEB_HOSTNAMES": "dev",
    "SITE_FALLBACK_ORIGIN": "sites.site.localhost",
    "PAYMENTS": "dev",
    "MAIL_ADAPTER": "dev",
    "DNS_RESOLVER": "dev",
    "AWS_REGION": "us-east-1",
    "PLATFORM_MAIL_DOMAIN": "mail.swarm.localhost",
    "MEDIA_ORIGIN": "http://localhost:8792",
    "PLATFORM_SITE_DOMAIN": "site.localhost",
    "SITE_SCHEME": "http",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swarm",
      "database_id": "local",
      "migrations_dir": "../../migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "local" }],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "swarm-media" },
    { "binding": "IMPORTS", "bucket_name": "swarm-imports" },
    { "binding": "EXPORTS", "bucket_name": "swarm-exports" },
    { "binding": "DEV_MAILBOX", "bucket_name": "swarm-dev-mailbox" },
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS_QUEUE", "queue": "swarm-jobs" },
      { "binding": "SEND_QUEUE", "queue": "swarm-send" },
      { "binding": "WEBHOOKS_QUEUE", "queue": "swarm-webhooks" },
    ],
    "consumers": [
      {
        "queue": "swarm-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "dead_letter_queue": "swarm-jobs-dlq",
      },
      {
        "queue": "swarm-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "swarm-webhooks-dlq",
      },
      {
        "queue": "swarm-public",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "dead_letter_queue": "swarm-public-dlq",
      },
    ],
  },
  // The install's sending limits (the realtime worker's SendPacer): this worker's mail counts too.
  "durable_objects": {
    "bindings": [
      { "name": "SEND_PACER", "class_name": "SendPacer", "script_name": "swarm-realtime-local" },
    ],
  },
  // The vault (workers/vault), through its JobsVault entrypoint and no other: sealed values,
  // the links it signs and the provider credentials it holds. Every env block names it too.
  "services": [{ "binding": "VAULT", "service": "swarm-vault-local", "entrypoint": "JobsVault" }],
  "env": {
    "staging": {
      "name": "swarm-jobs-staging",
      "workers_dev": false,
      "preview_urls": false,
